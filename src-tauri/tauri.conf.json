{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnema",
  "version": "0.0.0",
  "identifier": "com.mnema.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "../scripts/before-dev.sh",
    "beforeBuildCommand": "../scripts/before-build.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mnema",
        "url": "launcher.html",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": ["binaries/mnema-extract-worker"],
    "resources": {
      "../vendor/pdfium/lib/libpdfium.dylib": "pdfium/lib/libpdfium.dylib",
      "../vendor/pdfium/VERSION": "pdfium/VERSION",
      "../vendor/pdfium/LICENSE": "pdfium/LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
