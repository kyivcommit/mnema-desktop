{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnema",
  "version": "0.0.0",
  "identifier": "com.mnema.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "../scripts/stage-sidecar.sh debug",
    "beforeBuildCommand": "../scripts/stage-sidecar.sh release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mnema",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": ["binaries/mnema-extract-worker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
